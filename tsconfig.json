{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": [
			"DOM",
			"ES2018"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
