{
	"name": "s3-sync",
	"version": "0.1.0",
	"description": "Minimal AWS S3 sync plugin for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p tsconfig.test.json && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"keywords": [
		"obsidian",
		"s3",
		"sync",
		"aws"
	],
	"author": "fabian",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jest": "^29.7.0",
		"obsidian": "^1.7.2",
		"ts-jest": "^29.1.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1026.0",
		"@smithy/protocol-http": "^5.3.7",
		"@smithy/types": "^4.11.0",
		"idb": "^8.0.1"
	}
}
